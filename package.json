{
  "name": "mwa-music-starter",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source starting point for music apps powered by the MWA API.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "ableton:setup": "npm --prefix integrations/ableton ci --ignore-scripts",
    "ableton": "node --env-file-if-exists=.env server/index.mjs --ableton",
    "ableton:import": "node --env-file-if-exists=.env server/index.mjs --ableton-import",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-release.mjs",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json",
    "verify": "npm run check && npm test && npm run typecheck",
    "prepare:github": "node scripts/prepare-github.mjs",
    "sdk:pack": "node scripts/pack-sdk.mjs",
    "release": "node scripts/package-release.mjs"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
